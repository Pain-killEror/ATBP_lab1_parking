{
  "name": "lab6_ci_cd",
  "version": "1.0.0",
  "description": "CI/CD Pipeline with Jest, Cucumber, and Playwright",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:unit": "jest",
    "test:bdd": "cucumber-js --format json:allure-results/cucumber.json",
    "test:ui": "npx playwright test",
    "test:all": "npm run test:unit && npm run test:bdd && npm run test:ui",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.40.0",
    "allure-commandline": "^2.24.0",
    "allure-cucumberjs": "^2.15.1",
    "allure-jest": "^2.15.1",
    "allure-playwright": "^2.9.2",
    "jest": "^29.7.0"
  }
}